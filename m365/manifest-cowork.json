{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "__M365_MANIFEST_VERSION__",
  "id": "5ebfbba2-fdca-4e0c-b352-4fa1183b29ae",
  "developer": {
    "name": "StewAI AG",
    "websiteUrl": "https://outsidechair.com",
    "privacyUrl": "https://outsidechair.com/privacy",
    "termsOfUseUrl": "https://outsidechair.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Outside Chair",
    "full": "Outside Chair Strategy Companion"
  },
  "description": {
    "short": "Governed strategy, team deliberation and shared analysis.",
    "full": "An agent-native strategy companion for governed team viewpoints, evidence, reviews, decisions, actions and outcomes. Responses are generated by AI using authorised Outside Chair context and must be reviewed by the user."
  },
  "accentColor": "#163D35",
  "validDomains": [
    "app.outsidechair.com",
    "outsidechair.com"
  ],
  "agentSkills": [
    {
      "folder": "skills/outside-chair-strategy-companion"
    }
  ],
  "agentConnectors": [
    {
      "id": "outside-chair",
      "displayName": "Outside Chair",
      "description": "Read and update governed strategy, team deliberation and Analysis Exchange records through the Outside Chair MCP server.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://app.outsidechair.com/mcp",
          "mcpToolDescription": {
            "file": "tools/outside-chair-tools.json"
          },
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "__M365_OAUTH_REFERENCE_ID__"
          }
        }
      }
    }
  ]
}
